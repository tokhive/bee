{
  "name": "bee-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "test:e2e": "playwright test",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test:bridge": "node --test tests/bridge.test.ts tests/bridgeMonitor.test.ts tests/lifecycle.test.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  }
}
