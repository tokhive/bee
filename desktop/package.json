{
  "name": "bee-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:tooling && npm run test:e2e && npm run test:device && npm run test:preview",
    "test:unit": "node --test \"tests/*.test.ts\"",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort --open /tests/fixtures/bee-preview/index.html",
    "test:e2e": "playwright test",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test:bridge": "node --test tests/bridge.test.ts tests/bridgeMonitor.test.ts tests/lifecycle.test.ts",
    "tauri": "tauri",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 1420 --strictPort",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 1420 --strictPort",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "test:device": "node --test tests/device.test.ts tests/supply.test.ts tests/nativeAccounts.test.ts && playwright test --config playwright.device.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.43.0",
    "radix-ui": "1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  }
}
