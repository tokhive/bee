+/** Feature copy follows the existing application locale without modifying shared dictionaries. */
+export function wizardText(value:string):string{return currentLocale()==='en'?(english[value]??value):value;}
diff --git a/desktop/src/features/device/first-launch-wizard.css b/desktop/src/features/device/first-launch-wizard.css
