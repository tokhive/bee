{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bee S2 Probe",
  "version": "0.1.0",
  "identifier": "dev.tokhive.bee.s2-probe",
  "build": { "frontendDist": ["index.html", "probe.js", "probe.css"] },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "probe", "create": false, "title": "Bee S2 Native Probe", "width": 1000, "height": 760, "minWidth": 760, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "capabilities": [{ "identifier": "experience-probe", "windows": ["probe"], "permissions": ["core:event:allow-listen", "core:event:allow-unlisten"] }]
    }
  },
  "bundle": { "active": false, "icon": ["../../../src-tauri/icons/32x32.png"] }
}
