+	endpoint := s.URL + "/api/bee/runtime-recovery/" + input.ID
+	status, _, data = request(t, client(t), "POST", endpoint, input, secret)
+	if status != 200 || data["state"] != "draining" || data["unfinished"] != true || data["preparations_retired"] != false {
+		t.Fatal("unfinished work was certified retired", status, data)
+	}
+	var barrier *string
+	if err = pool.QueryRow(context.Background(), `SELECT preparation_id FROM provider_platform_controls WHERE user_id=$1 AND platform='openai'`, ownerID).Scan(&barrier); err != nil || barrier == nil || *barrier != prepID {
