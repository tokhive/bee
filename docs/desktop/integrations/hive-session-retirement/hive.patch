+	if err = pool.QueryRow(context.Background(), `SELECT preparation_id FROM provider_platform_controls WHERE user_id=$1 AND platform='openai'`, identity["owner_id"]).Scan(&barrier); err != nil || barrier == nil || *barrier != prepID {
+		t.Fatal("conflict released original barrier", err, barrier)
+	}
+	var cancelled bool
+	if err = pool.QueryRow(context.Background(), `SELECT cancelled FROM provider_supply_preparations WHERE user_id=$1 AND platform='openai' AND id=$2`, identity["owner_id"], prepID).Scan(&cancelled); err != nil || cancelled {
+		t.Fatal("conflict cancelled original preparation", err, cancelled)
+	}
+}
