index 0000000..a7b61c3
--- /dev/null
+++ b/hive/internal/integration/runtime_recovery_native_test.go
@@ -0,0 +1,224 @@
+package integration_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/tokhive/bee/beewire"
+	hive "github.com/tokhive/hive/hive/internal/app"
+	"github.com/tokhive/tee/tee"
+)
+
+// Rust owns the real Go management subprocess. Hive owns its actual router,
+// Market and isolated PostgreSQL schema. Faults are injected outside production
+// code; no production account, official endpoint or shared config is involved.
+func TestRuntimeRecoveryNativeDesktop(t *testing.T) {
+	rust := os.Getenv("BEE_RETIREMENT_RUST_TEST_BINARY")
+	if rust == "" || os.Getenv("BEE_NATIVE_BRIDGE_TEST_BINARY") == "" {
+		t.Skip("BEE_RETIREMENT_RUST_TEST_BINARY and BEE_NATIVE_BRIDGE_TEST_BINARY required")
+	}
+	for _, scenario := range []string{"success", "lost_response", "draining_restart", "conflict", "exit_race"} {
+		t.Run(scenario, func(t *testing.T) {
+			dsn := database(t)
+			key, err := tee.GenerateInboxKey()
+			if err != nil {
+				t.Fatal(err)
+			}
+			pub := key.Public()
+			app, err := hive.New(context.Background(), hive.Config{DatabaseURL: dsn, PublicURL: "http://hive.test", PasswordCost: testPasswordCost, InboxPublic: &pub})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(app.Close)
+			pool, err := pgxpool.New(context.Background(), dsn)
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(pool.Close)
+			var entered, posts, dropped, pauseWrites, agentConnections atomic.Int32
+			var mu sync.Mutex
+			var original *beewire.RuntimeRecoveryRequest
+			release := make(chan struct{})
+			var releaseOnce sync.Once
+			t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
+			s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, q *http.Request) {
+				if strings.HasPrefix(q.URL.Path, "/__fixture/") {
+					switch strings.TrimPrefix(q.URL.Path, "/__fixture/") {
+					case "release":
+						releaseOnce.Do(func() { close(release) })
+					case "complete":
+						if _, err := pool.Exec(q.Context(), `UPDATE execution_attempts SET state='failed',upstream_termination='confirmed',finished_at=clock_timestamp() WHERE id='native-attempt'`); err != nil {
+							t.Error(err)
+							w.WriteHeader(500)
+							return
+						}
+					}
+					json.NewEncoder(w).Encode(map[string]any{"post_entered": entered.Load() > 0})
+					return
+				}
+				if q.URL.Path == "/api/bee/agent" {
+					agentConnections.Add(1)
+				}
+				if q.Method == "PUT" && (q.URL.Path == "/api/bee/platforms/openai" || q.URL.Path == "/api/bee/platforms/claude") {
+					// Decode only to count pause writes; preserve the exact body.
+					var body json.RawMessage
+					if err := json.NewDecoder(q.Body).Decode(&body); err != nil {
+						t.Error(err)
+						return
+					}
+					q.Body.Close()
+					q.Body = io.NopCloser(bytes.NewReader(body))
+					var v struct {
+						Paused *bool `json:"paused"`
+					}
+					if err := json.Unmarshal(body, &v); err != nil {
+						t.Error(err)
+						return
+					}
+					if v.Paused != nil {
+						pauseWrites.Add(1)
+					}
+				}
+				if q.Method == "POST" && strings.HasPrefix(q.URL.Path, "/api/bee/runtime-recovery/") {
+					var input beewire.RuntimeRecoveryRequest
+					if err := json.NewDecoder(q.Body).Decode(&input); err != nil {
+						t.Error(err)
+						return
+					}
+					raw, _ := json.Marshal(input)
+					q.Body = io.NopCloser(bytes.NewReader(raw))
+					mu.Lock()
+					if original != nil {
+						a, _ := json.Marshal(original)
+						if string(a) != string(raw) {
+							t.Error("native retry changed the original request")
+						}
+					} else {
+						original = &input
+					}
+					mu.Unlock()
+					posts.Add(1)
+					entered.Store(1)
+					if scenario == "exit_race" {
+						select {
+						case <-release:
+						case <-q.Context().Done():
+							return
+						}
+					}
+					if scenario == "lost_response" && dropped.CompareAndSwap(0, 1) {
+						recorder := httptest.NewRecorder()
+						app.ServeHTTP(recorder, q)
+						if recorder.Code != 200 {
+							t.Errorf("fault injected before successful Hive commit: status=%d body=%s", recorder.Code, recorder.Body.String())
+						}
+						conn, _, err := w.(http.Hijacker).Hijack()
+						if err != nil {
+							t.Error(err)
+							return
+						}
+						conn.Close()
+						return
+					}
+				}
+				app.ServeHTTP(w, q)
+			}))
+			t.Cleanup(func() { releaseOnce.Do(func() { close(release) }); s.Close() })
+			owner := registerBuyer(t, s, "native@example.test")
+			secret := bindBee(t, s, owner)
+			status, _, identity := request(t, client(t), "GET", s.URL+"/api/bee/identity", nil, secret)
+			if status != 200 {
+				t.Fatal(status, identity)
+			}
+			for platform, paused := range map[string]bool{"openai": true, "claude": false} {
+				status, _, data := request(t, client(t), "PUT", s.URL+"/api/bee/platforms/"+platform, map[string]bool{"paused": paused}, secret)
+				if status != 200 {
+					t.Fatal(status, data)
+				}
+			}
+			pauseWrites.Store(0)
+			if scenario == "draining_restart" {
+				for _, sql := range []string{
+					`INSERT INTO api_keys(id,user_id,name,prefix,token_hash) VALUES('native-key',$1,'fixture','test','test')`,
+					`INSERT INTO models(id,platform,protocol,synthetic) VALUES('native-model','openai','responses',true)`,
+					`INSERT INTO model_versions(model_id,version,name,cache_mode,prices,enabled,source_url,source_note) VALUES('native-model',1,'fixture','none','{}',true,'https://example.test','fixture')`,
+					`INSERT INTO buyer_requests(id,buyer_id,api_key_id,model_id) VALUES('native-request',$1,'native-key','native-model')`,
+					`INSERT INTO execution_attempts(id,request_id,provider_id,device_id,model_id,model_version,prices,supply_factor,commission_rate,job_hash,state) VALUES('native-attempt','native-request',$1,$2,'native-model',1,'{}',0.1,0.1,decode('00','hex'),'running')`,
+				} {
+					var args []any
+					if strings.Contains(sql, "$1") {
+						args = append(args, identity["owner_id"])
+					}
+					if strings.Contains(sql, "$2") {
+						args = append(args, identity["id"])
+					}
+					if _, err := pool.Exec(context.Background(), sql, args...); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			fixture := filepath.Join(t.TempDir(), "fixture.json")
+			raw, _ := json.Marshal(map[string]any{"hive": s.URL, "credential": secret, "identity": identity, "scenario": scenario})
+			if err := os.WriteFile(fixture, raw, 0600); err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+			defer cancel()
+			command := exec.CommandContext(ctx, rust, "native_retirement_tests::native_retirement_through_real_hive", "--exact", "--ignored", "--nocapture")
+			command.Env = append(os.Environ(), "BEE_RUNTIME_HIVE_FIXTURE="+fixture)
+			output, err := command.CombinedOutput()
+			if err != nil {
+				t.Fatalf("native scenario=%s exit=%v\n%s", scenario, err, output)
+			}
+			t.Log(string(output))
+			if pauseWrites.Load() != 0 {
+				t.Fatalf("recovery rewrote pause choice: writes=%d", pauseWrites.Load())
+			}
+			if posts.Load() == 0 {
+				t.Fatal("native path never reached actual Hive retirement")
+			}
+			if scenario == "lost_response" && (dropped.Load() != 1 || posts.Load() != 1) {
+				t.Fatalf("lost reply not reconciled by original GET: dropped=%d posts=%d", dropped.Load(), posts.Load())
+			}
+			for platform, paused := range map[string]bool{"openai": true, "claude": false} {
+				status, _, data := request(t, client(t), "GET", s.URL+"/api/bee/platforms/"+platform, nil, secret)
+				if status != 200 || data["paused"] != paused {
+					t.Fatal("pause choice changed", platform, status, data)
+				}
+			}
+			if scenario == "conflict" || scenario == "exit_race" {
+				if agentConnections.Load() != 0 {
+					t.Fatal("blocked startup opened contribution connection")
+				}
+			}
+			mu.Lock()
+			id := original.ID
+			mu.Unlock()
+			status, _, data := request(t, client(t), "GET", s.URL+"/api/bee/runtime-recovery/"+id, nil, secret)
+			want := "retired"
+			if scenario == "conflict" {
+				want = "draining"
+			}
+			if status != 200 || data["state"] != want {
+				t.Fatal("unexpected final remote proof", status, data)
+			}
+			status, _, data = request(t, client(t), "PUT", s.URL+"/api/bee/platforms/openai", map[string]bool{"paused": false}, secret)
+			if status != 409 {
+				t.Fatal("old epoch still writable", status, data)
+			}
+		})
+	}
+}
