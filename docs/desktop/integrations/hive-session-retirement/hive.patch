+++ b/hive/internal/controller/runtime_recovery.go
@@ -0,0 +1,47 @@
+package controller
+
+import (
+	"context"
+	"github.com/tokhive/bee/beewire"
+	"github.com/tokhive/hive/hive/internal/middleware"
+	"net/http"
+	"strings"
+)
+
+type runtimeAdmissionContextKey struct{}
+
+func (s *Controller) RuntimeFence(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		connection := r.URL.Path == "/api/bee/agent" || r.URL.Path == "/api/bee/connect"
+		if !strings.HasPrefix(r.URL.Path, "/api/bee/") || strings.HasPrefix(r.URL.Path, "/api/bee/pairings") || strings.HasPrefix(r.URL.Path, "/api/bee/runtime-recovery/") || r.Method == http.MethodGet && !connection {
+			next.ServeHTTP(w, r)
+			return
+		}
+		identity, ok := s.currentDevice(w, r)
+		if !ok {
+			return
+		}
+		release, err := s.market.BeginRuntimeRequest(r.Context(), identity, r.Header.Get(beewire.RuntimeEpochHeader))
+		if err != nil {
+			middleware.WriteError(w, err)
+			return
+		}
+		defer release()
+		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), runtimeAdmissionContextKey{}, release)))
+	})
+}
+func (s *Controller) RuntimeRecovery(w http.ResponseWriter, r *http.Request) {
+	identity, ok := s.currentDevice(w, r)
+	if !ok {
+		return
+	}
+	var input *beewire.RuntimeRecoveryRequest
+	if r.Method == http.MethodPost {
+		input = &beewire.RuntimeRecoveryRequest{}
+		if !middleware.DecodeJSON(w, r, input) {
+			return
+		}
+	}
+	result, err := s.market.RuntimeRecovery(r.Context(), identity, r.PathValue("operation"), input)
+	middleware.Reply(w, result, err)
+}
