diff --git a/hive/internal/service/runtime_recovery.go b/hive/internal/service/runtime_recovery.go
new file mode 100644
index 0000000..172aea9
--- /dev/null
+++ b/hive/internal/service/runtime_recovery.go
@@ -0,0 +1,264 @@
+package service
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"sync"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/tokhive/bee/beewire"
+	domain "github.com/tokhive/hive/hive/internal/model"
+	"golang.org/x/sync/semaphore"
+)
+
+const runtimeGateCapacity int64 = 1 << 20
+
+type runtimeRequestGate struct{ permits *semaphore.Weighted }
+
+func newRuntimeRequestGate() *runtimeRequestGate {
+	return &runtimeRequestGate{semaphore.NewWeighted(runtimeGateCapacity)}
+}
+func (g *runtimeRequestGate) acquire(ctx context.Context, exclusive bool) error {
+	n := int64(1)
+	if exclusive {
+		n = runtimeGateCapacity
+	}
+	return g.permits.Acquire(ctx, n)
+}
+func (g *runtimeRequestGate) release(exclusive bool) {
+	n := int64(1)
+	if exclusive {
+		n = runtimeGateCapacity
+	}
+	g.permits.Release(n)
+}
+func (s *Market) runtimeGate(device string) *runtimeRequestGate {
+	g, _ := s.runtimeGates.LoadOrStore(device, newRuntimeRequestGate())
+	return g.(*runtimeRequestGate)
+}
+
+// Bee's connection registry has one Market owner. Hold shared admission until
+// an HTTP mutation finishes, or until a WebSocket has registered its connection.
+// Retirement drains these permits, persists the epoch, then joins that connection.
+func (s *Market) BeginRuntimeRequest(ctx context.Context, identity beewire.Identity, epoch string) (func(), error) {
+	g := s.runtimeGate(identity.ID)
+	if err := g.acquire(ctx, false); err != nil {
+		return nil, err
+	}
+	var once sync.Once
+	release := func() { once.Do(func() { g.release(false) }) }
+	var current string
+	var pending *string
+	err := s.pool.QueryRow(ctx, `SELECT epoch,pending_id FROM bee_runtime_epochs WHERE device_id=$1`, identity.ID).Scan(&current, &pending)
+	if err != nil && !errors.Is(err, pgx.ErrNoRows) {
+		release()
+		return nil, fmt.Errorf("read runtime epoch before mutation: %w", err)
+	}
+	if current != epoch || pending != nil {
+		release()
+		return nil, domain.Fail(409, "runtime_retired", fmt.Sprintf("runtime request rejected: epoch_match=%t retirement_pending=%t; use the original retirement operation", current == epoch, pending != nil))
+	}
+	return release, nil
+}
+
+func validateRuntimeRecoveryRequest(v beewire.RuntimeRecoveryRequest) error {
+	if !preparationHex(v.ID, 24) || v.PreviousEpoch != "" && !preparationHex(v.PreviousEpoch, 24) || !preparationHex(v.PreviousRunID, 16) || !preparationHex(v.AccountRevision, 32) || v.Preparations == nil || len(v.Preparations) > 2 {
+		return domain.Fail(400, "invalid_runtime_recovery", "runtime retirement requires original operation, epoch, run, account revision and explicit preparation map")
+	}
+	for p, v := range v.Preparations {
+		if p != "openai" && p != "claude" || v.ID != "" && !preparationHex(v.ID, 24) || !preparationHex(v.Fingerprint, 32) {
+			return domain.Fail(400, "invalid_runtime_recovery", "runtime retirement preparation requires known platform, original ID and account fingerprint")
+		}
+	}
+	return nil
+}
+func (s *Market) RuntimeRecovery(ctx context.Context, identity beewire.Identity, id string, input *beewire.RuntimeRecoveryRequest) (domain.Result, error) {
+	if !preparationHex(id, 24) {
+		return domain.Result{}, domain.Fail(400, "invalid_runtime_recovery", "runtime retirement ID requires 48 lowercase hex characters")
+	}
+	if input == nil {
+		result, err := s.runtimeRecoveryResult(ctx, identity, id)
+		return domain.Result{Status: 200, Data: result}, err
+	}
+	if err := validateRuntimeRecoveryRequest(*input); err != nil {
+		return domain.Result{}, err
+	}
+	if input.ID != id {
+		return domain.Result{}, domain.Fail(400, "invalid_runtime_recovery", "runtime retirement path and body IDs differ")
+	}
+	g := s.runtimeGate(identity.ID)
+	if err := g.acquire(ctx, true); err != nil {
+		return domain.Result{}, err
+	}
+	defer g.release(true)
+	// This transaction fences every later old write. It remains pending across
+	// disconnects and restarts, so a dropped response cannot reopen old admission.
+	tx, err := s.pool.Begin(ctx)
+	if err != nil {
+		return domain.Result{}, err
+	}
+	defer tx.Rollback(ctx)
+	var active bool
+	if err = tx.QueryRow(ctx, `SELECT revoked_at IS NULL FROM bee_devices WHERE id=$1 AND user_id=$2 FOR NO KEY UPDATE`, identity.ID, identity.OwnerID).Scan(&active); err != nil {
+		return domain.Result{}, err
+	}
+	if !active {
+		return domain.Result{}, domain.Fail(401, "device_replaced", "runtime retirement requires original active device")
+	}
+	if _, err = tx.Exec(ctx, `INSERT INTO bee_runtime_epochs(device_id,epoch) VALUES($1,'') ON CONFLICT DO NOTHING`, identity.ID); err != nil {
+		return domain.Result{}, err
+	}
+	var epoch string
+	var pending *string
+	if err = tx.QueryRow(ctx, `SELECT epoch,pending_id FROM bee_runtime_epochs WHERE device_id=$1 FOR UPDATE`, identity.ID).Scan(&epoch, &pending); err != nil {
+		return domain.Result{}, err
+	}
+	var raw []byte
+	var phase string
+	err = tx.QueryRow(ctx, `SELECT request,phase FROM bee_runtime_recoveries WHERE device_id=$1 AND id=$2`, identity.ID, id).Scan(&raw, &phase)
+	if err == nil {
+		var saved beewire.RuntimeRecoveryRequest
+		if err = json.Unmarshal(raw, &saved); err != nil {
+			return domain.Result{}, err
+		}
+		if !reflect.DeepEqual(saved, *input) {
+			return domain.Result{}, domain.Fail(409, "runtime_recovery_conflict", "original retirement parameters differ; original operation retained")
+		}
+		if phase == "retired" {
+			if err = tx.Commit(ctx); err != nil {
+				return domain.Result{}, err
+			}
+			result, err := s.runtimeRecoveryResult(ctx, identity, id)
+			return domain.Result{Status: 200, Data: result}, err
+		}
+		if pending == nil || *pending != id || epoch != id {
+			return domain.Result{}, domain.Fail(409, "runtime_recovery_conflict", "original pending retirement does not own current epoch; evidence retained")
+		}
+	} else if errors.Is(err, pgx.ErrNoRows) {
+		if pending != nil || epoch != input.PreviousEpoch {
+			return domain.Result{}, domain.Fail(409, "runtime_recovery_conflict", fmt.Sprintf("retirement predecessor rejected: epoch_match=%t pending=%t; reconcile original ID", epoch == input.PreviousEpoch, pending != nil))
+		}
+		raw, _ = json.Marshal(input)
+		if _, err = tx.Exec(ctx, `INSERT INTO bee_runtime_recoveries(device_id,id,request,phase) VALUES($1,$2,$3,'draining')`, identity.ID, id, raw); err != nil {
+			return domain.Result{}, err
+		}
+		if _, err = tx.Exec(ctx, `UPDATE bee_runtime_epochs SET epoch=$2,pending_id=$2 WHERE device_id=$1`, identity.ID, id); err != nil {
+			return domain.Result{}, err
+		}
+	} else {
+		return domain.Result{}, err
+	}
+	if err = tx.Commit(ctx); err != nil {
+		return domain.Result{}, err
+	}
+	s.bees.mu.Lock()
+	entry := s.bees.live[identity.ID]
+	if entry != nil {
+		entry.cancel()
+	}
+	s.bees.mu.Unlock()
+	if entry != nil {
+		select {
+		case <-entry.done:
+		case <-ctx.Done():
+			return domain.Result{}, fmt.Errorf("original runtime connection has not joined: operation=%s: %w", id, ctx.Err())
+		}
+	}
+	unfinished, err := deviceHasUnfinished(ctx, s.pool, identity.ID, s.executionBudget)
+	if err != nil {
+		return domain.Result{}, err
+	}
+	if !unfinished {
+		if err = s.finishRuntimeRetirement(ctx, identity, *input); err != nil {
+			return domain.Result{}, err
+		}
+	}
+	result, err := s.runtimeRecoveryResult(ctx, identity, id)
+	return domain.Result{Status: 200, Data: result}, err
+}
+func (s *Market) runtimeRecoveryResult(ctx context.Context, identity beewire.Identity, id string) (beewire.RuntimeRecoveryResult, error) {
+	result := beewire.RuntimeRecoveryResult{Version: 1, DeviceID: identity.ID, OwnerID: identity.OwnerID, State: "absent"}
+	var raw []byte
+	err := s.pool.QueryRow(ctx, `SELECT r.request,r.phase,e.epoch FROM bee_runtime_recoveries r JOIN bee_runtime_epochs e USING(device_id) WHERE r.device_id=$1 AND r.id=$2`, identity.ID, id).Scan(&raw, &result.State, &result.Epoch)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return result, nil
+	}
+	if err != nil {
+		return result, err
+	}
+	if err = json.Unmarshal(raw, &result.Request); err != nil {
+		return result, err
+	}
+	if result.State == "retired" {
+		result.ConnectionRetired = true
+		result.PreparationsRetired = true
+		return result, nil
+	}
+	s.bees.mu.Lock()
+	result.ConnectionRetired = s.bees.live[identity.ID] == nil
+	s.bees.mu.Unlock()
+	result.Unfinished, err = deviceHasUnfinished(ctx, s.pool, identity.ID, s.executionBudget)
+	return result, err
+}
+func (s *Market) finishRuntimeRetirement(ctx context.Context, identity beewire.Identity, input beewire.RuntimeRecoveryRequest) error {
+	tx, err := s.pool.Begin(ctx)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback(ctx)
+	var epoch string
+	var pending *string
+	if err = tx.QueryRow(ctx, `SELECT epoch,pending_id FROM bee_runtime_epochs WHERE device_id=$1 FOR UPDATE`, identity.ID).Scan(&epoch, &pending); err != nil {
+		return err
+	}
+	if epoch != input.ID || pending == nil || *pending != input.ID {
+		return domain.Fail(409, "runtime_recovery_conflict", "retirement no longer owns device epoch; original evidence retained")
+	}
+	for _, platform := range []string{"openai", "claude"} {
+		if _, err = tx.Exec(ctx, `INSERT INTO provider_platform_controls(user_id,platform) VALUES($1,$2) ON CONFLICT DO NOTHING`, identity.OwnerID, platform); err != nil {
+			return err
+		}
+		var current *string
+		if err = tx.QueryRow(ctx, `SELECT preparation_id FROM provider_platform_controls WHERE user_id=$1 AND platform=$2 FOR UPDATE`, identity.OwnerID, platform).Scan(&current); err != nil {
+			return err
+		}
+		selected, exists := input.Preparations[platform]
+		if current != nil && (!exists || *current != selected.ID) {
+			return domain.Fail(409, "runtime_preparation_conflict", fmt.Sprintf("retirement preparation differs: platform=%s selected=%t id_match=false; original barrier retained", platform, exists))
+		}
+		account, err := scanAccount(tx.QueryRow(ctx, accountSelect+` FOR SHARE`, identity.OwnerID, platform))
+		if err != nil && !errors.Is(err, pgx.ErrNoRows) {
+			return err
+		}
+		if err == nil && exists && (account.PendingFingerprint != "" || account.AccountFingerprint != "" && account.AccountFingerprint != selected.Fingerprint) {
+			return domain.Fail(409, "runtime_account_conflict", fmt.Sprintf("retirement account differs: platform=%s pending=%t fingerprint_match=%t; original operation must be reconciled", platform, account.PendingFingerprint != "", account.AccountFingerprint == selected.Fingerprint))
+		}
+		if current == nil {
+			continue
+		}
+		var device, fingerprint string
+		var completed, cancelled bool
+		if err = tx.QueryRow(ctx, `SELECT device_id,account_fingerprint,completed,cancelled FROM provider_supply_preparations WHERE user_id=$1 AND platform=$2 AND id=$3 FOR UPDATE`, identity.OwnerID, platform, *current).Scan(&device, &fingerprint, &completed, &cancelled); err != nil {
+			return err
+		}
+		if device != identity.ID || fingerprint != selected.Fingerprint || completed || cancelled {
+			return domain.Fail(409, "runtime_preparation_conflict", fmt.Sprintf("retirement preparation ownership rejected: platform=%s device_match=%t fingerprint_match=%t terminal=%t; barrier retained", platform, device == identity.ID, fingerprint == selected.Fingerprint, completed || cancelled))
+		}
+		if _, err = tx.Exec(ctx, `UPDATE provider_supply_preparations SET cancelled=true WHERE user_id=$1 AND platform=$2 AND id=$3`, identity.OwnerID, platform, *current); err != nil {
+			return err
+		}
+		if _, err = tx.Exec(ctx, `UPDATE provider_platform_controls SET preparation_id=NULL WHERE user_id=$1 AND platform=$2 AND preparation_id=$3`, identity.OwnerID, platform, *current); err != nil {
+			return err
+		}
+	}
+	if _, err = tx.Exec(ctx, `UPDATE bee_runtime_recoveries SET phase='retired' WHERE device_id=$1 AND id=$2 AND phase='draining'`, identity.ID, input.ID); err != nil {
+		return err
+	}
+	if _, err = tx.Exec(ctx, `UPDATE bee_runtime_epochs SET pending_id=NULL WHERE device_id=$1 AND pending_id=$2`, identity.ID, input.ID); err != nil {
+		return err
+	}
+	return tx.Commit(ctx)
+}
diff --git a/hive/internal/service/runtime_recovery_test.go b/hive/internal/service/runtime_recovery_test.go
new file mode 100644
index 0000000..58ef2ae
--- /dev/null
+++ b/hive/internal/service/runtime_recovery_test.go
@@ -0,0 +1,42 @@
+package service
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestRuntimeRecoveryGateDrainsAdmittedWritesAndRejectsLateAdmission(t *testing.T) {
+	g := newRuntimeRequestGate()
+	if err := g.acquire(context.Background(), false); err != nil {
+		t.Fatal(err)
+	}
+	entered := make(chan struct{})
+	done := make(chan struct{})
+	go func() {
+		close(entered)
+		if err := g.acquire(context.Background(), true); err != nil {
+			t.Error(err)
+			return
+		}
+		close(done)
+	}()
+	<-entered
+	select {
+	case <-done:
+		t.Fatal("retirement passed an admitted write")
+	case <-time.After(15 * time.Millisecond):
+	}
+	g.release(false)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("retirement did not drain original write")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Millisecond)
+	defer cancel()
+	if err := g.acquire(ctx, false); err == nil {
+		t.Fatal("old request admitted during retirement")
+	}
+	g.release(true)
+}
