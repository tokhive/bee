+	endpoint := server.URL + "/api/bee/runtime-recovery/" + input.ID
+	status, _, data = request(t, client(t), "POST", endpoint, input, secret)
+	if status != 409 {
+		t.Fatal("conflicting preparation certified retired", status, data)
+	}
+	status, _, data = request(t, client(t), "GET", endpoint, nil, secret)
+	if status != 200 || data["state"] != "draining" || data["preparations_retired"] != false {
+		t.Fatal(status, data)
