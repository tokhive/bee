@@ -0,0 +1,264 @@
+package integration_test
+
+import (
+	"context"
+	"github.com/coder/websocket"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/tokhive/bee/beewire"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestRuntimeRecoveryFencesOldRequestsPreservesPauseAndSurvivesRestart(t *testing.T) {
+	dsn := database(t)
+	s := start(t, dsn)
+	owner := registerBuyer(t, s, "retirement@example.test")
+	secret := bindBee(t, s, owner)
+	status, _, identity := request(t, client(t), "GET", s.URL+"/api/bee/identity", nil, secret)
+	if status != 200 {
+		t.Fatal(status, identity)
+	}
+	device, ownerID := identity["id"].(string), identity["owner_id"].(string)
+	pool, err := pgxpool.New(context.Background(), dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	prepID, fp := strings.Repeat("a", 48), strings.Repeat("b", 64)
+	status, _, data := request(t, client(t), "PUT", s.URL+"/api/bee/platforms/openai", map[string]any{"preparation": map[string]string{"id": prepID, "action": "begin", "account_fingerprint": fp}}, secret)
+	if status != 200 {
+		t.Fatal(status, data)
+	}
+	for p, paused := range map[string]bool{"openai": true, "claude": false} {
+		status, _, data = request(t, client(t), "PUT", s.URL+"/api/bee/platforms/"+p, map[string]bool{"paused": paused}, secret)
+		if status != 200 {
+			t.Fatal(status, data)
+		}
+	}
+	input := beewire.RuntimeRecoveryRequest{ID: strings.Repeat("c", 48), PreviousRunID: strings.Repeat("d", 32), AccountRevision: strings.Repeat("e", 64), Preparations: map[string]beewire.RuntimeRecoveryPreparation{"openai": {ID: prepID, Fingerprint: fp}}}
+	socketCtx, cancelSocket := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancelSocket()
+	oldConnection, _, err := websocket.Dial(socketCtx, strings.Replace(s.URL, "http://", "ws://", 1)+"/api/bee/connect", &websocket.DialOptions{HTTPHeader: http.Header{"Authorization": []string{"Bearer " + secret}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer oldConnection.CloseNow()
+	endpoint := s.URL + "/api/bee/runtime-recovery/" + input.ID
+	status, _, data = request(t, client(t), "POST", endpoint, input, secret)
+	if status != 200 || data["state"] != "retired" || data["connection_retired"] != true || data["preparations_retired"] != true || data["epoch"] != input.ID {
+		t.Fatal(status, data)
+	}
+	if _, _, err = oldConnection.Read(socketCtx); err == nil {
+		t.Fatal("old connection remained open after retirement proof")
+	}
+	for _, epoch := range []string{"", strings.Repeat("f", 48)} {
+		status, _, data = request(t, client(t), "PUT", s.URL+"/api/bee/platforms/openai", map[string]bool{"paused": false}, secret, map[string]string{beewire.RuntimeEpochHeader: epoch})
+		if status != 409 {
+			t.Fatalf("late old request admitted: %d %v", status, data)
+		}
+	}
+	var paused bool
+	var current *string
+	var cancelled bool
+	if err = pool.QueryRow(context.Background(), `SELECT paused,preparation_id FROM provider_platform_controls WHERE user_id=$1 AND platform='openai'`, ownerID).Scan(&paused, &current); err != nil || !paused || current != nil {
+		t.Fatal("retirement changed pause or retained barrier", err, paused, current)
+	}
+	if err = pool.QueryRow(context.Background(), `SELECT cancelled FROM provider_supply_preparations WHERE user_id=$1 AND platform='openai' AND id=$2`, ownerID, prepID).Scan(&cancelled); err != nil || !cancelled {
+		t.Fatal("preparation not retired", err)
+	}
+	status, _, data = request(t, client(t), "POST", endpoint, input, secret)
+	if status != 200 || data["state"] != "retired" {
+		t.Fatal("original replay", status, data)
+	}
+	altered := input
+	altered.AccountRevision = strings.Repeat("f", 64)
+	status, _, data = request(t, client(t), "POST", endpoint, altered, secret)
+	if status != 409 {
+		t.Fatal("changed original request accepted", status, data)
+	}
+	s.Close()
+	restarted := start(t, dsn)
+	status, _, data = request(t, client(t), "PUT", restarted.URL+"/api/bee/platforms/openai", map[string]bool{"paused": false}, secret)
+	if status != 409 {
+		t.Fatal("restart accepted legacy request", status, data)
+	}
+	status, _, data = request(t, client(t), "PUT", restarted.URL+"/api/bee/platforms/claude", map[string]bool{"paused": false}, secret, map[string]string{beewire.RuntimeEpochHeader: input.ID})
+	if status != 200 {
+		t.Fatal("successor request rejected", status, data)
+	}
+	if device == "" {
+		t.Fatal("fixture identity absent")
+	}
+}
+func TestRuntimeRecoveryWaitsForAlreadyAdmittedSupplyWrite(t *testing.T) {
+	dsn := database(t)
+	s := start(t, dsn)
+	owner := registerBuyer(t, s, "drain@example.test")
+	secret := bindBee(t, s, owner)
+	_, _, identity := request(t, client(t), "GET", s.URL+"/api/bee/identity", nil, secret)
+	ownerID := identity["owner_id"].(string)
+	pool, err := pgxpool.New(context.Background(), dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	_, err = pool.Exec(context.Background(), `INSERT INTO provider_platform_controls(user_id,platform,paused) VALUES($1,'openai',false)`, ownerID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tx, err := pool.Begin(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback(context.Background())
+	if _, err = tx.Exec(context.Background(), `SELECT 1 FROM provider_platform_controls WHERE user_id=$1 AND platform='openai' FOR UPDATE`, ownerID); err != nil {
+		t.Fatal(err)
+	}
+	oldDone := make(chan int, 1)
+	go func() {
+		status, _, _ := request(t, client(t), "PUT", s.URL+"/api/bee/platforms/openai", map[string]bool{"paused": true}, secret)
+		oldDone <- status
+	}()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		var blocked bool
+		if err = pool.QueryRow(context.Background(), `SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE wait_event_type='Lock' AND query LIKE '%INSERT INTO provider_platform_controls%' AND query NOT LIKE '%pg_stat_activity%')`).Scan(&blocked); err != nil {
+			t.Fatal(err)
+		}
+		if blocked {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("old supply write did not reach held row")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	input := beewire.RuntimeRecoveryRequest{ID: strings.Repeat("a", 48), PreviousRunID: strings.Repeat("b", 32), AccountRevision: strings.Repeat("c", 64), Preparations: map[string]beewire.RuntimeRecoveryPreparation{}}
+	retirementDone := make(chan map[string]any, 1)
+	go func() {
+		status, _, data := request(t, client(t), "POST", s.URL+"/api/bee/runtime-recovery/"+input.ID, input, secret)
+		if status != 200 {
+			t.Error(status, data)
+		}
+		retirementDone <- data
+	}()
+	select {
+	case <-retirementDone:
+		t.Fatal("retirement passed already admitted write")
+	case <-time.After(20 * time.Millisecond):
+	}
+	if err = tx.Commit(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if status := <-oldDone; status != 200 {
+		t.Fatal(status)
+	}
+	if data := <-retirementDone; data["state"] != "retired" {
+		t.Fatal(data)
+	}
+	_, _, data := request(t, client(t), "GET", s.URL+"/api/bee/platforms/openai", nil, secret)
+	if data["paused"] != true {
+		t.Fatal("lost latest pause", data)
+	}
+}
+
+func TestRuntimeRecoveryKeepsUnfinishedWorkAndOriginalPreparationBlocked(t *testing.T) {
+	dsn := database(t)
+	s := start(t, dsn)
+	owner := registerBuyer(t, s, "unfinished@example.test")
+	secret := bindBee(t, s, owner)
+	_, _, identity := request(t, client(t), "GET", s.URL+"/api/bee/identity", nil, secret)
+	ownerID, device := identity["owner_id"].(string), identity["id"].(string)
+	pool, err := pgxpool.New(context.Background(), dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pool.Close()
+	exec := func(sql string, args ...any) {
+		t.Helper()
+		if _, err := pool.Exec(context.Background(), sql, args...); err != nil {
+			t.Fatal(err)
+		}
+	}
+	exec(`INSERT INTO api_keys(id,user_id,name,prefix,token_hash) VALUES('key',$1,'fixture','test','test')`, ownerID)
+	exec(`INSERT INTO models(id,platform,protocol,synthetic) VALUES('fixture','openai','responses',true)`)
+	exec(`INSERT INTO model_versions(model_id,version,name,cache_mode,prices,enabled,source_url,source_note) VALUES('fixture',1,'fixture','none','{}',true,'https://example.test','fixture')`)
+	exec(`INSERT INTO buyer_requests(id,buyer_id,api_key_id,model_id) VALUES('request',$1,'key','fixture')`, ownerID)
+	exec(`INSERT INTO execution_attempts(id,request_id,provider_id,device_id,model_id,model_version,prices,supply_factor,commission_rate,job_hash,state) VALUES('attempt','request',$1,$2,'fixture',1,'{}',0.1,0.1,decode('00','hex'),'running')`, ownerID, device)
+	prepID, fp := strings.Repeat("a", 48), strings.Repeat("b", 64)
